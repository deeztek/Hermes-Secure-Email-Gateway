# Date-stamped pre-modification backups created by rotate_db_credentials.sh
# (and any other future bash script following the same `.bak.YYYYMMDD` pattern).
# These are transient operator safety nets; the canonical version history is
# in git. Filed for proper backup-suffix unification: #256-followup.
*.bak.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]
