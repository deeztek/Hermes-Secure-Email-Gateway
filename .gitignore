license-server/
license-check-workflow.md

# ===========================================
# GENERATED FILES WITH SENSITIVE DATA
# ===========================================

# Generated AD integration scheduled tasks (contain LDAP credentials)
config/hermes/var/www/html/schedule/*_ad_tasks.cfm

# Temporary config files generated during operation
config/hermes/opt/hermes/tmp/*
!config/hermes/opt/hermes/tmp/.gitkeep

# Install log files (written by install_hermes_docker.sh)
install-logs/

# Postfix/Nginx config files with environment-specific data.
#
# Three classes of postfix files are gitignored:
#
#   1. Rendered configs (install script + CFML write at runtime):
#      main.cf only. (master.cf is tracked: zero placeholders, no CFML
#      writes -- it's a pure framework file like dynamicmaps.cf etc.
#      The .dkim/.non-dkim/.postscreen variants ARE tracked too as
#      alternative framework topologies admin can swap in.)
#
#   2. Admin-managed lookup tables (CFML generates from DB, or admin
#      edits via UI). Real prod data must NEVER be committed:
#      transport, transport.BACK, virtual, bcc_maps, tls_policy,
#      sender_access, relay_domains, relay_recipients, networks,
#      amavis_senderbypass, postscreen_access.cidr,
#      regexp_header_checks, relay_passwd, sasl_passwd
#
#   3. Compiled hashmap .db files (postmap regenerates from .text source
#      every time):
#      *.db
config/postfix-dkim/etc/postfix/main.cf
config/postfix-dkim/etc/postfix/main.cf.*
config/postfix-dkim/etc/postfix/transport
config/postfix-dkim/etc/postfix/transport.BACK
config/postfix-dkim/etc/postfix/virtual
config/postfix-dkim/etc/postfix/bcc_maps
config/postfix-dkim/etc/postfix/tls_policy
config/postfix-dkim/etc/postfix/sender_access
config/postfix-dkim/etc/postfix/relay_domains
config/postfix-dkim/etc/postfix/relay_recipients
config/postfix-dkim/etc/postfix/networks
config/postfix-dkim/etc/postfix/amavis_senderbypass
config/postfix-dkim/etc/postfix/postscreen_access.cidr
config/postfix-dkim/etc/postfix/regexp_header_checks
config/postfix-dkim/etc/postfix/relay_passwd
config/postfix-dkim/etc/postfix/sasl_passwd
config/postfix-dkim/etc/postfix/*.db
config/nginx/etc/nginx/sites-available/hermes-ssl.conf
config/nginx/etc/nginx/sites-available/hermes-ssl.*
# CFML mailbox-domains feature generates <random>_hermes-mailbox-ssl.conf
# per mailbox domain (e.g. Tf2gwPQp_hermes-mailbox-ssl.conf) into
# sites-available. Generated at runtime by view_mailbox_domains.cfm /
# inc/generate_nginx_configuration.cfm -- must never be tracked.
config/nginx/etc/nginx/sites-available/*_hermes-mailbox-ssl.conf
# sites-enabled: install script symlinks hermes-ssl.conf into here at
# bootstrap; CFML enables per-mailbox-domain configs at runtime. Track
# the dir itself (.gitkeep) but ignore all contents.
config/nginx/etc/nginx/sites-enabled/*
!config/nginx/etc/nginx/sites-enabled/.gitkeep

# CFML write-time backups (each generate_*.cfm copies the live file to
# <name>.HERMES before re-rendering). Canonical templates live separately
# at config/hermes/opt/hermes/conf_files/ and config/hermes/opt/hermes/templates/.
config/nginx/etc/nginx/snippets/auth.HERMES

# /etc/mailname rendered output (amavis container). Canonical template:
# config/hermes/opt/hermes/conf_files/mailname.HERMES
config/common/etc/mailname

# SpamAssassin config (may have custom rules/IPs)
config/mail_filter/etc/spamassassin/local.cf
config/hermes/opt/hermes/conf_files/local.cf.*

