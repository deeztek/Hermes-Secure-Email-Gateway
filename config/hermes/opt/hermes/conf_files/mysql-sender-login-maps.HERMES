hosts = hermes_db_server
dbname = hermes
user = HERMES-USERNAME
password = HERMES-PASSWORD
query = SELECT slm.login_user FROM sender_login_maps slm JOIN (SELECT LOWER('%s') AS sender) si ON LOWER(slm.sender) = si.sender UNION SELECT t.username AS login_user FROM transactional_smtp_credentials t JOIN parameters2 p ON p.module = 'transactional_email' AND p.parameter = 'enabled' AND p.value2 = '1' WHERE t.active = 1 AND ((t.allowed_senders IS NOT NULL AND TRIM(t.allowed_senders) <> '' AND FIND_IN_SET(LOWER('%s'), REPLACE(LOWER(t.allowed_senders), ' ', '')) > 0) OR ((t.allowed_senders IS NULL OR TRIM(t.allowed_senders) = '') AND t.allowed_domains IS NOT NULL AND TRIM(t.allowed_domains) <> '' AND FIND_IN_SET(SUBSTRING_INDEX(LOWER('%s'), '@', -1), REPLACE(LOWER(t.allowed_domains), ' ', '')) > 0) OR ((t.allowed_senders IS NULL OR TRIM(t.allowed_senders) = '') AND (t.allowed_domains IS NULL OR TRIM(t.allowed_domains) = '') AND EXISTS (SELECT 1 FROM domains d WHERE LOWER(d.domain) = SUBSTRING_INDEX(LOWER('%s'), '@', -1))))
