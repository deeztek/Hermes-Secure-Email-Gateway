#
# Hermes SEG MariaDB overrides (#339)
#
# Read via /etc/my.cnf's `!includedir /etc/my.cnf.d`. The base image starts
# mariadbd with --defaults-extra-file=/config/custom.cnf, which is layered on
# AFTER this file, so anything set in both places is won by custom.cnf. Only
# set things custom.cnf does not mention.
#
# custom.cnf itself is generated by the base image on first init and lives
# inside the db_data volume, so it is not ours to edit and is not in this repo.
#
# [mariadb] rather than [mysqld]: these are MariaDB-specific options and would
# be unknown variables to anything else parsing the file.
#
[mariadb]

# Binary logs were never purged on any Hermes install, and the reason is not
# the retention policy. log_bin is on and custom.cnf sets expire_logs_days=10,
# which resolves to a live binlog_expire_logs_seconds=864000. Both correct.
#
# But every automatic purge mechanism (binlog_expire_logs_seconds,
# expire_logs_days, max_binlog_total_size) refuses to delete a binary log
# until at least `slave_connections_needed_for_purge` REPLICAS have processed
# it. That defaults to 1. Hermes has no replicas and no replication, so the
# threshold is never reached and the expiry never executes.
#
# The observed result was 15 months of binary logs, ~51GB, on an install whose
# databases totalled 6.2GB, until Postfix hit queue_minfree and began deferring
# mail with "452 4.3.1 Insufficient system storage".
#
# Introduced in MariaDB 11.4, alongside the .idx GTID-index companion files.
# Installs purged correctly before that version and silently stopped after it.
#
# This does not change the retention policy. It permits the policy that is
# already configured to run.
slave_connections_needed_for_purge = 0
