#!/bin/bash
# Hermes SEG Pre-commit Hook
# This hook blocks sensitive paths AND runs gitleaks for content scanning

set -e

echo "Running pre-commit security checks..."
echo ""

# Get the repo root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# ===========================================
# LAYER 1: Block sensitive paths (catches what gitleaks misses)
# ===========================================
echo "[1/6] Checking for sensitive file paths..."

# Define sensitive path patterns (files that should NEVER be committed)
SENSITIVE_PATHS=(
    "*/opt/hermes/keys/*"
    "*/opt/hermes/ssl/*"
    "*/opt/hermes/CA/*"
    "*/opt/hermes/creds/*"
    "*/opt/hermes/dkim/keys/*"
    "*/opt/hermes/apache_certs/*"
    "*/opt/hermes/HermesExternalCACerts/*"
    "*_ad_tasks.cfm"
    "config/certbot/*"
    "config/authelia/*.pem"
    "config/authelia/*.key"
    "*.private"
    "*.pfx"
    "*password_file"
    "*secret_file"
    "*secret_key_file"
    "*.env"
    "*mysql-*.cf"
    "*50-user"
    "*hibernate.cfg.xml"
    "*dovecot-sql*.conf"
    "*cloudflare-token.conf"
)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
BLOCKED_FILES=""

for file in $STAGED_FILES; do
    # Exception: an EMPTY .gitkeep is a directory placeholder, not key material.
    # Several sensitive dirs must exist in a fresh clone or the app breaks at
    # runtime (e.g. opendkim-genkey cannot create its own -D dir, so a missing
    # dkim/keys/ makes DKIM key generation fail on every fresh install).
    # The emptiness check is what keeps this safe -- a non-empty file named
    # .gitkeep still gets blocked.
    if [[ "$(basename "$file")" == ".gitkeep" ]]; then
        if [[ -s "$REPO_ROOT/$file" ]]; then
            BLOCKED_FILES="$BLOCKED_FILES\n  - $file (non-empty .gitkeep)"
        fi
        continue
    fi
    for pattern in "${SENSITIVE_PATHS[@]}"; do
        if [[ "$file" == $pattern ]]; then
            BLOCKED_FILES="$BLOCKED_FILES\n  - $file"
        fi
    done
done

if [ -n "$BLOCKED_FILES" ]; then
    echo ""
    echo "=============================================="
    echo "  SENSITIVE FILES DETECTED - COMMIT BLOCKED"
    echo "=============================================="
    echo ""
    echo "The following files match sensitive path patterns:"
    echo -e "$BLOCKED_FILES"
    echo ""
    echo "These files should be in .gitignore and never committed."
    echo ""
    echo "Actions:"
    echo "  1. Unstage the file: git reset HEAD <file>"
    echo "  2. Add to .gitignore if not already present"
    echo "  3. If intentional, use: git commit --no-verify (NOT RECOMMENDED)"
    echo ""
    exit 1
fi

echo "      No sensitive paths detected."

# ===========================================
# LAYER 2: DEV/customer production-data signatures
# Catches the dev-dump leak class (real customer domains/emails/IPs, dev hosts)
# that gitleaks does NOT flag because it isn't a "secret" by shape.
# ===========================================
echo "[2/6] Scanning staged content for DEV/customer data..."

# High-confidence signatures only (keep false positives near zero).
# NOTE: deeztek.com is legitimate (docs/support/license); only .net/.org are dev.
DEV_PAT='dino\.edwards|@deeztek\.(net|org)|mydirectmail|getwithme|speyecare|mycomputersquad|glaucomaplus|thepediatriccenter|patuxentcardiology|grubbcontractors|bolanderhome|homedc01\.deeztek|smtp-dev\.|\b15\.235\.97\.|\b100\.16\.199\.|\b172\.16\.50\.2\b'

DEV_HITS=""
for file in $STAGED_FILES; do
    # skip binaries / vendored packages / images, and the guard tooling itself
    # (this hook + gitleaks config legitimately contain the signature strings)
    case "$file" in
        *.deb|*.tar.gz|*.tar.xz|*.xz|*.gz|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.db|*.pdf) continue ;;
        scripts/pre-commit|.gitleaks.toml) continue ;;
    esac
    match=$(git show ":$file" 2>/dev/null | grep -inE "$DEV_PAT" 2>/dev/null \
            | grep -viE "claude@deeztek\.net|corp\.example\.com" | head -3 || true)
    if [ -n "$match" ]; then
        DEV_HITS="$DEV_HITS\n  $file:\n$(echo "$match" | sed 's/^/      /')"
    fi
done

if [ -n "$DEV_HITS" ]; then
    echo ""
    echo "=============================================="
    echo "  DEV/CUSTOMER DATA DETECTED - COMMIT BLOCKED"
    echo "=============================================="
    echo ""
    echo "Staged content matches known DEV/customer production-data signatures:"
    echo -e "$DEV_HITS"
    echo ""
    echo "Scrub with @domain.tld / example.com placeholders before committing."
    echo "If this is a genuine false positive: git commit --no-verify"
    echo ""
    exit 1
fi

echo "      No DEV/customer data signatures detected."

# ===========================================
# LAYER 3: Guard the scanner's own blind spot
# gitleaks does NOT scan its own config file, so a real secret pasted into
# .gitleaks.toml (e.g. as a "Catches: ..." example) is invisible to Layer 5.
# This is exactly how a real DB password once shipped to the public repo.
# ===========================================
echo "[3/6] Checking .gitleaks.toml for real secrets (scanner blind spot)..."

if echo "$STAGED_FILES" | grep -qx ".gitleaks.toml"; then
    # Flag 12+ char alphanumeric tokens that mix UPPER, lower AND digit -- the
    # shape of a real credential. Placeholders (EXAMPLE_REDACTED_PW,
    # hermes_db_password, MARIADB_ROOT_PASSWORD) and the rules' own regex
    # char-classes lack that mix or are broken by _ and -, so they don't match.
    TOML_HITS=$(git show ":.gitleaks.toml" 2>/dev/null \
        | grep -oE '[A-Za-z0-9]{12,}' \
        | grep -E '[A-Z]' | grep -E '[a-z]' | grep -E '[0-9]' \
        | grep -viE '^(EXAMPLE|REDACTED|CHANGEME|YOURPASSWORD)$' \
        | head -5 || true)
    if [ -n "$TOML_HITS" ]; then
        echo ""
        echo "=============================================="
        echo "  REAL SECRET IN .gitleaks.toml - COMMIT BLOCKED"
        echo "=============================================="
        echo ""
        echo ".gitleaks.toml appears to contain a real credential-shaped token."
        echo "gitleaks never scans its own config, so this would ship undetected."
        echo "Replace it with a fake placeholder (e.g. EXAMPLE_REDACTED_PW):"
        echo "$TOML_HITS" | sed 's/^/      /'
        echo ""
        echo "If genuinely a false positive: git commit --no-verify"
        echo ""
        exit 1
    fi
fi

echo "      No real secrets in .gitleaks.toml."

# ===========================================
# LAYER 4: Hardcoded install roots
# The install root varies per host (/opt/hermes-seg, /opt/hermes-seg-docker-gl,
# /opt/hermes-seg-container-gl, /opt/Hermes-Secure-Email-Gateway, ...). Baking
# one into executable code breaks every install that chose a different path.
# This shipped three times: hermes_smoke_test.sh (#284) and
# migrate_legacy_to_docker.sh both aborted outright, and two admin pages printed
# copy-pasteable commands with the wrong path (one of them the DEV path).
#
# Use instead:
#   shell -> the walk-up self-locator (find docker-compose.yml from BASH_SOURCE[0])
#   CFML  -> <cfinclude template="./inc/docker_get_directory.cfm"> then #DockerDir#
#
# Comments are allowed (prose/examples); only live code is blocked.
# ===========================================
echo "[4/6] Checking for hardcoded install roots..."

ROOT_PAT='/opt/(hermes-seg|hermes-seg-docker-gl|hermes-seg-container-gl|Hermes-Secure-Email-Gateway)'
ROOT_HITS=""

for file in $STAGED_FILES; do
    # Only executable surfaces. Docs/markdown legitimately name concrete paths.
    case "$file" in
        *.sh|*.cfm|*.cfc) ;;
        *) continue ;;
    esac
    # The guard itself defines the patterns.
    [ "$file" = "scripts/pre-commit" ] && continue

    # Strip comment lines: shell (leading #) and CFML (any line containing <!--).
    # Multi-line CFML comment bodies are NOT detected -- if one legitimately
    # needs a literal path, reword it or use --no-verify with justification.
    match=$(git show ":$file" 2>/dev/null | grep -nE "$ROOT_PAT" 2>/dev/null \
            | grep -vE '^[0-9]+:[[:space:]]*#' \
            | grep -vE '^[0-9]+:.*<!--' \
            | head -3 || true)
    if [ -n "$match" ]; then
        ROOT_HITS="$ROOT_HITS\n  $file:\n$(echo "$match" | sed 's/^/      /')"
    fi
done

if [ -n "$ROOT_HITS" ]; then
    echo ""
    echo "=============================================="
    echo "  HARDCODED INSTALL ROOT - COMMIT BLOCKED"
    echo "=============================================="
    echo ""
    echo "Live code must not assume a fixed install root:"
    echo -e "$ROOT_HITS"
    echo ""
    echo "Resolve it at runtime instead:"
    echo "  shell: walk up from BASH_SOURCE[0] looking for docker-compose.yml"
    echo "         (see scripts/system_rehost.sh or hermes_smoke_test.sh)"
    echo "  CFML:  <cfinclude template=\"./inc/docker_get_directory.cfm\">"
    echo "         then use #DockerDir#"
    echo ""
    echo "If this is prose rather than code, make it a comment."
    echo "If genuinely a false positive: git commit --no-verify"
    echo ""
    exit 1
fi

echo "      No hardcoded install roots detected."

# ===========================================
# LAYER 5: Generated-artifact drift
# ===========================================
# config/ofelia/config.ini is generated from the ofelia_jobs seed rows but is
# tracked anyway (hermes_ofelia needs a valid file at first container start,
# before the DB exists to render from). It was committed at v260612 and never
# updated again -- four seeded jobs silently stopped shipping and the update
# check kept calling a script removed at #218. See #288.
#
# Only runs when one of the two files is actually staged.
echo "[5/6] Checking generated artifacts against their seed..."

if echo "$STAGED_FILES" | grep -qxE "config/ofelia/config\.ini|config/database/hermes_install\.sql"; then
    DRIFT_CHECK="$(git rev-parse --show-toplevel)/scripts/check_ofelia_seed_drift.sh"
    if [[ -x "$DRIFT_CHECK" ]]; then
        if ! "$DRIFT_CHECK"; then
            echo ""
            echo "COMMIT BLOCKED: shipped Ofelia schedule is out of sync with its seed."
            echo ""
            exit 1
        fi
    else
        echo "      WARNING: $DRIFT_CHECK missing or not executable - skipping."
    fi
else
    echo "      Neither config.ini nor hermes_install.sql staged - skipped."
fi

# ===========================================
# LAYER 6: Content scanning with gitleaks
# ===========================================
echo "[6/6] Scanning file contents for secrets..."

# Check if gitleaks is installed
if ! command -v gitleaks &> /dev/null; then
    echo ""
    echo "WARNING: gitleaks is not installed. Skipping content scan."
    echo ""
    echo "Install gitleaks for full protection:"
    echo "  Windows (scoop): scoop install gitleaks"
    echo "  Windows (choco): choco install gitleaks"
    echo "  macOS: brew install gitleaks"
    echo "  Linux: https://github.com/gitleaks/gitleaks/releases"
    echo ""
    echo "Proceeding with path-based checks only..."
    exit 0
fi

# Run gitleaks on staged files only
if gitleaks protect --staged --config="$REPO_ROOT/.gitleaks.toml" --verbose; then
    echo ""
    echo "All checks passed. Proceeding with commit."
    exit 0
else
    echo ""
    echo "=============================================="
    echo "  SECRETS DETECTED - COMMIT BLOCKED"
    echo "=============================================="
    echo ""
    echo "Gitleaks found potential secrets in your staged files."
    echo ""
    echo "Actions:"
    echo "  1. Remove the secret from the file"
    echo "  2. Add the file to .gitignore if it shouldn't be tracked"
    echo "  3. If it's a false positive, add an exception to .gitleaks.toml"
    echo ""
    echo "To bypass (use with caution):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
