#!/bin/bash
set -e

echo "Starting rsyslog...."
/usr/sbin/rsyslogd

###############################################################################
# 0. Gather secrets and environment variables
###############################################################################

LDAP_ADMIN_PASS=$(cat /run/secrets/LDAP_ADMIN_PASSWORD)
LDAP_USER_PASS=$(cat /run/secrets/LDAP_USER_PASSWORD)
LDAP_DOMAIN=${LDAP_DOMAIN:-hermes.local}
LDAP_ADMIN_USERNAME=${LDAP_ADMIN_USERNAME:-hermes-ldap-admin}
LDAP_USER_USERNAME=${LDAP_USER_USERNAME:-hermes-ldap-user}
LDAP_GROUPS=${LDAP_GROUPS:-"admins relays mailboxes two_factor one_factor"}

REAL_SUFFIX="dc=$(echo "$LDAP_DOMAIN" | sed 's/\./,dc=/g')"
REAL_ADMIN_DN="cn=${LDAP_ADMIN_USERNAME},$REAL_SUFFIX"
LDAPI_URI="ldapi://%2Fvar%2Frun%2Fslapd%2Fldapi"
SLAPD_CONFIG_DIR="/etc/ldap/slapd.d"
LDAP_DB_DIR="/var/lib/ldap/$LDAP_DOMAIN"

###############################################################################
# 1. Ensure required directories and permissions
###############################################################################

mkdir -p "$SLAPD_CONFIG_DIR"
mkdir -p "$LDAP_DB_DIR"
mkdir -p /var/run/slapd
chown -R root:root /etc/ldap /var/lib/ldap /var/run/slapd
chmod 0777 /var/run/slapd
chmod 0777 "$LDAP_DB_DIR"
rm -rf /var/run/slapd/slapd.pid /var/run/slapd/slapd.args
mkdir -p /tmp/schema-config
chmod 700 /tmp/schema-config

###############################################################################
# 2. Bootstrap slapd.d with all required schemas and ACLs
###############################################################################

if [ ! -d "$SLAPD_CONFIG_DIR" ] || [ -z "$(ls -A "$SLAPD_CONFIG_DIR")" ]; then
  echo "Bootstrapping slapd.d..."
cat >/tmp/min-slapd.conf <<EOF
include         /usr/local/etc/openldap/schema/core.schema
include         /usr/local/etc/openldap/schema/cosine.schema
include         /usr/local/etc/openldap/schema/nis.schema
include         /usr/local/etc/openldap/schema/inetorgperson.schema
include         /usr/local/etc/openldap/schema/remoteauth.schema

access to *
  by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage
  by * none

access to dn.children="cn=config"
  by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage
  by * none

access to dn.base="cn=config"
  by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage
  by * none

pidfile         /var/run/slapd/slapd.pid
argsfile        /var/run/slapd/slapd.args
modulepath      /usr/local/libexec/openldap
moduleload      back_mdb
database        mdb
directory       $LDAP_DB_DIR
suffix          $REAL_SUFFIX
rootdn          $REAL_ADMIN_DN
rootpw          $LDAP_ADMIN_PASS
EOF
  slaptest -f /tmp/min-slapd.conf -F "$SLAPD_CONFIG_DIR" -n 0
  chown -R root:root "$SLAPD_CONFIG_DIR"
fi

###############################################################################
# 3. Start slapd in background so LDAPI works for config mutations
###############################################################################

echo "Starting slapd for LDAPI configuration..."
/usr/local/libexec/slapd -F "$SLAPD_CONFIG_DIR" -h "ldap:/// $LDAPI_URI" -u root -g root -d 128 &
SLAPD_PID=$!

for i in {1..60}; do
  [ -S /var/run/slapd/ldapi ] && break
  sleep 1
done
chmod 0777 /var/run/slapd/ldapi 2>/dev/null || true
for i in {1..20}; do
  ldapwhoami -Y EXTERNAL -H "$LDAPI_URI" &>/dev/null && break
  sleep 1
done

###############################################################################
# 4. Load required modules (argon2, remoteauth) if not already present
###############################################################################

ldapmodify -Y EXTERNAL -H "$LDAPI_URI" <<EOF || true
dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: argon2.la
olcModuleLoad: remoteauth.la
EOF

###############################################################################
# 5. Convert and import remoteauth.schema if not yet loaded
###############################################################################

if ! ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "cn=schema,cn=config" | grep -q "remoteauth"; then
  if [ -f /usr/local/etc/openldap/schema/remoteauth.schema ]; then
    echo "include /usr/local/etc/openldap/schema/remoteauth.schema" > /tmp/remoteauth.conf
    rm -rf /tmp/schema-config
    mkdir -p /tmp/schema-config
    slaptest -f /tmp/remoteauth.conf -F /tmp/schema-config
    REMOTEAUTH_LDIF=$(ls /tmp/schema-config/cn=config/cn=schema/cn=\{*\}remoteauth.ldif | head -1)
    if [ -f "$REMOTEAUTH_LDIF" ]; then
      ldapadd -Y EXTERNAL -H "$LDAPI_URI" -f "$REMOTEAUTH_LDIF"
      rm -rf /tmp/schema-config
      rm -f /tmp/remoteauth.conf
    else
      echo "ERROR: Remoteauth LDIF not found after slaptest conversion."
      exit 1
    fi
  else
    echo "ERROR: remoteauth.schema missing at /usr/local/etc/openldap/schema/remoteauth.schema"
    exit 1
  fi
fi

###############################################################################
# 6. Create the main LDAP database if needed
###############################################################################

LDAP_ADMIN_PASSWORD_HASH=$(/usr/local/sbin/slappasswd -o module-load=argon2.so -h '{ARGON2}' -s "$LDAP_ADMIN_PASS")

if ! ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "olcDatabase={1}mdb,cn=config" dn 2>/dev/null | grep -q "^dn:"; then
ldapmodify -Y EXTERNAL -H "$LDAPI_URI" <<EOF || true
dn: olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcSuffix: $REAL_SUFFIX
olcRootDN: $REAL_ADMIN_DN
olcRootPW: $LDAP_ADMIN_PASSWORD_HASH
olcDbDirectory: $LDAP_DB_DIR
olcDbIndex: objectClass eq
olcDbIndex: uid,uidNumber,gidNumber,memberUid eq
olcDbIndex: cn,sn,mail eq,sub
olcAccess: to * by dn.exact="$REAL_ADMIN_DN" manage by * none
EOF
fi

###############################################################################
# 7. Create base DN if absent
###############################################################################

ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "$REAL_SUFFIX" -s base dn 2>/dev/null | grep -q "dn:" || ldapadd -Y EXTERNAL -H "$LDAPI_URI" <<EOF
dn: $REAL_SUFFIX
objectClass: dcObject
objectClass: organization
dc: $(echo "$LDAP_DOMAIN" | cut -d'.' -f1)
o: $(echo "$LDAP_DOMAIN")
EOF

###############################################################################
# 8. Add a demo/test user, if missing
###############################################################################

USER_DN="cn=${LDAP_USER_USERNAME},${REAL_SUFFIX}"
if ! ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "$USER_DN" dn 2>/dev/null | grep -q "^dn:"; then
  USER_PASSWORD_HASH=$(/usr/local/sbin/slappasswd -o module-load=argon2.so -h "{ARGON2}" -s "$LDAP_USER_PASS")
  ldapadd -Y EXTERNAL -H "$LDAPI_URI" <<EOF
dn: $USER_DN
objectClass: inetOrgPerson
cn: Hermes User
sn: User
uid: ${LDAP_USER_USERNAME}
userPassword: ${USER_PASSWORD_HASH}
mail: hermes-user@example.local
EOF
fi

###############################################################################
# 9. Create ou=groups and dynamically add group entries
###############################################################################

GROUPS_OU="ou=groups,$REAL_SUFFIX"
ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "$GROUPS_OU" dn 2>/dev/null | grep -q "^dn:" || ldapadd -Y EXTERNAL -H "$LDAPI_URI" <<EOF
dn: $GROUPS_OU
objectClass: top
objectClass: organizationalUnit
ou: groups
EOF

for grp in $LDAP_GROUPS; do
  GRP_DN="cn=${grp},ou=groups,${REAL_SUFFIX}"
  ldapsearch -Y EXTERNAL -H "$LDAPI_URI" -b "$GRP_DN" dn 2>/dev/null | grep -q "^dn:" || ldapadd -Y EXTERNAL -H "$LDAPI_URI" <<EOF
dn: $GRP_DN
objectClass: groupOfNames
objectClass: top
cn: $grp
member: cn=${LDAP_USER_USERNAME},${REAL_SUFFIX}
EOF
done

###############################################################################
# 10. Stop background slapd, launch in foreground
###############################################################################

kill -INT "$SLAPD_PID" 2>/dev/null || true
sleep 3
rm -f /var/run/slapd/slapd.pid /var/run/slapd/slapd.args

echo "Starting slapd as main service..."
exec /usr/local/libexec/slapd -F "$SLAPD_CONFIG_DIR" -h "ldap:/// $LDAPI_URI" -u root -g root -d 256

