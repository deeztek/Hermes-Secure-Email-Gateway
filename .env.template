# Hermes SEG Docker Environment Configuration Template
# Copy this file to .env and fill in the values

# (HERMES_USERNAME / HERMES_PASSWORD removed: these were legacy bare-metal
#  installer leftovers and were never consumed by anything in the Docker
#  setup -- docker-compose doesn't inject .env into containers, Dovecot's
#  quota-warning.sh reads /opt/hermes/creds/ directly, and no CFML / shell
#  script sources .env. Confirmed vestigial; deleted to avoid confusion.)

# Docker Image Version (format: vYYMMDD, e.g., v260119 for Jan 19, 2026)
HERMES_DOCKER_IMG_VERSION=latest

# Docker Image Registry
# Default: ghcr.io/deeztek (GitHub Container Registry -- official distribution)
# Legacy / dev override: hub.deeztek.com/dedwards/hermes-seg-docker-gl
# If unset, docker-compose.yml falls back to ghcr.io/deeztek via ${IMAGE_REGISTRY:-...}.
IMAGE_REGISTRY=ghcr.io/deeztek

# Network Configuration
# WARNING: Do NOT change IPV4SUBNET unless you know what you are doing.
# This subnet is hardcoded in Postfix, Amavis, Dovecot, Ciphermail, OpenDKIM,
# and OpenDMARC configurations. Changing it will break mail delivery, spam
# filtering, DKIM/DMARC verification, and other critical services.
IPV4SUBNET=172.16.32
HOST_IP=YOUR_HOST_IP
CONSOLE_HOST=mail.example.com
HERMES_HOSTNAME=mail.example.com

# Timezone
TIMEZONE=America/New_York

# Container User/Group IDs (match host user for volume permissions)
PUID=1000
GUID=1000

# Storage mount points -- the five-tier storage topology (#260)
# These drive the `device:` paths in docker-compose.yml volumes. install_hermes_docker.sh's
# `prompt_mount_points()` collects the operator's chosen paths and `generate_compose_override()`
# strips + rewrites these four lines in the live .env after every run. The defaults below
# match DEFAULT_*_MOUNT in install_hermes_docker.sh so a `cp .env.template .env` produces
# a working config even if the install script hasn't run yet. See docs/install/storage-topology.md.
DATA_MOUNT=/mnt/data
ARCHIVE_MOUNT=/mnt/archive
VMAIL_MOUNT=/mnt/vmail
FILES_MOUNT=/mnt/files

# Brittle Component Pinned Versions
# (DOVECOTVERSION removed: we build our own hermes-dovecot image now,
#  so the upstream version pin lives in the Dockerfile's apt repo URL,
#  not here. NCVERSION and AUTHELIAVERSION are still used -- Nextcloud
#  builds atop the official nextcloud:NCVERSION image, and the Authelia
#  service pulls authelia/authelia:AUTHELIAVERSION directly.)
#
# NCVERSION is managed by Hermes release (#261) -- DO NOT EDIT.
# Hermes runs an integration checklist (OIDC, LDAP, theming, External
# Sites, Mail auto-provision, /nc-admin-login, trusted_domains, app
# compat) on Test before any release bumps this pin. Editing it
# yourself bypasses that testing and risks breaking the Nextcloud
# integration surface. If you need a newer NC than the current Hermes
# release ships, wait for the next release or file an issue requesting
# an earlier cut.
NCVERSION=30.0.15
AUTHELIAVERSION=4.39.16

# Nextcloud Configuration
# Credentials are read from /opt/hermes/creds/ via Docker secrets (single source of truth)
# Files: nextcloud_mysql_username, nextcloud_mysql_password, nextcloud_redis_password,
#        nextcloud_admin_username, nextcloud_admin_password
NEXTCLOUD_TRUSTED_DOMAINS=mail.example.com YOUR_HOST_IP
TRUSTED_PROXIES=172.16.0.0/12 127.0.0.1

# LDAP Configuration
LDAP_DOMAIN=hermes.local
LDAP_BASE_DN="dc=hermes,dc=local"
LDAP_ADMIN_USERNAME="hermes-ldap-admin"
LDAP_USER_USERNAME="hermes-ldap-user"
LDAP_GROUPS="admins relays mailboxes nextcloud two_factor one_factor readers"
# WARNING: DO NOT CHANGE LDAP_GROUPS or it will break Hermes authentication
LDAP_LOG_LEVEL=none

# Hermes application admin (web UI login via Authelia). Auto-populated by
# install_hermes_docker.sh with a random word+code username on first run.
# Distinct from LDAP_ADMIN_USERNAME (the LDAP rootDN/manager bind) and
# LDAP_USER_USERNAME (the read-only service account). The matching password
# is the Docker secret at config/hermes/opt/hermes/keys/hermes_admin_password_file.
HERMES_ADMIN_USERNAME=
# Log levels: https://kb.symas.com/reference/openldap-logging-and-debugging-levels
# Default is "stats". Do NOT use trace levels unless troubleshooting.

